<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme -->
    <style name="Theme.DayCheck.Light" parent="Theme.DayCheck">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:colorControlHighlight">@color/ripple_light</item>
    </style>
    
    <!-- Dark Theme -->
    <style name="Theme.DayCheck.Dark" parent="Theme.DayCheck">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOutline">@color/divider_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>
        <item name="android:colorControlHighlight">@color/ripple_dark</item>
    </style>
    
    <!-- Splash Screen Themes -->
    <style name="Theme.DayCheck.Splash.Light" parent="Theme.DayCheck.Splash">
        <item name="android:windowBackground">@drawable/splash_background_light</item>
    </style>
    
    <style name="Theme.DayCheck.Splash.Dark" parent="Theme.DayCheck.Splash">
        <item name="android:windowBackground">@drawable/splash_background_dark</item>
    </style>
    
    <!-- Dialog Themes -->
    <style name="Theme.DayCheck.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>
    
    <style name="Theme.DayCheck.Dialog.Dark" parent="Theme.DayCheck.Dialog">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="android:windowBackground">@drawable/dialog_background_dark</item>
    </style>
    
    <!-- Alert Dialog Themes -->
    <style name="Theme.DayCheck.AlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="buttonBarButtonStyle">@style/Widget.DayCheck.Button.Text</item>
    </style>
    
    <style name="Theme.DayCheck.AlertDialog.Dark" parent="Theme.DayCheck.AlertDialog">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
    </style>
    
    <!-- Bottom Sheet Themes -->
    <style name="Theme.DayCheck.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
    
    <style name="Theme.DayCheck.BottomSheet.Dark" parent="Theme.DayCheck.BottomSheet">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
    </style>
    
    <!-- Full Screen Themes -->
    <style name="Theme.DayCheck.FullScreen" parent="Theme.DayCheck">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <style name="Theme.DayCheck.FullScreen.Dark" parent="Theme.DayCheck.Dark">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <!-- No Action Bar Themes -->
    <style name="Theme.DayCheck.NoActionBar" parent="Theme.DayCheck">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <style name="Theme.DayCheck.NoActionBar.Dark" parent="Theme.DayCheck.Dark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- Transparent Themes -->
    <style name="Theme.DayCheck.Transparent" parent="Theme.DayCheck">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    
    <style name="Theme.DayCheck.Transparent.Dark" parent="Theme.DayCheck.Dark">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>