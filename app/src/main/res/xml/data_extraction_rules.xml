<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude database from cloud backup -->
        <exclude domain="database" path="daycheck_database" />
        <exclude domain="sharedpref" path="preferences.xml" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Allow device transfer of user data -->
        <include domain="database" path="daycheck_database" />
        <include domain="sharedpref" path="preferences.xml" />
    </device-transfer>
</data-extraction-rules>